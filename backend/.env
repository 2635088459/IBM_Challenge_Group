# Environment variables for the Autonomous AI Customs Clearance demo
# Do NOT commit real secrets to version control

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://customs:customs@db:5432/customs

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── LLM provider ──────────────────────────────────────────────────────────────
# Set to: openai | watsonx | mock
# Leave blank for auto-detect: OPENAI_API_KEY set → openai, WATSONX_API_KEY set → watsonx, else → mock
LLM_PROVIDER=

# OpenAI  ← paste your key here to activate GPT
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=512
OPENAI_TEMPERATURE=0.0

# IBM watsonx.ai (alternative)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Agent ─────────────────────────────────────────────────────────────────────
