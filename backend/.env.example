DATABASE_URL=postgresql://customs:customs@db:5432/customs
REDIS_URL=redis://redis:6379/0

# ── LLM provider ──────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to: openai | watsonx | mock
# If blank, auto-detected: OPENAI_API_KEY set → openai, WATSONX_API_KEY set → watsonx, else → mock
LLM_PROVIDER=

# OpenAI (recommended for demo — cheap + fast with gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=512
OPENAI_TEMPERATURE=0.0

# IBM watsonx.ai (alternative)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2
