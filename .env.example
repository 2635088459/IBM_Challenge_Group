# Environment variables — copy to backend/.env before running
# Do NOT commit real secrets to version control

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://customs:customs@localhost:5432/customs

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── IBM watsonx.ai (optional — falls back to mock LLM if not set) ─────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Agent ─────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── Document evidence store (defaults to ./evidence_store) ───────────────────
EVIDENCE_STORE_ROOT=./evidence_store

# ── Docker Compose overrides (used inside containers) ────────────────────────
# DATABASE_URL=postgresql://customs:customs@db:5432/customs
# REDIS_URL=redis://redis:6379/0
# API_BASE_URL=http://api:8000
